# ===========================================
# REQUIRED - Core Infrastructure
# ===========================================

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:password@localhost:5432/reviews_db"

# Redis (for background jobs)
REDIS_URL="redis://localhost:6379"

# NextAuth - Authentication
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"

# ===========================================
# OPTIONAL - Default/Fallback API Keys
# Note: These are FALLBACKS. Each tenant can
# configure their own keys in /dashboard/settings
# ===========================================

# Google OAuth (only if not using per-tenant credentials)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Claude API (fallback if tenant doesn't have their own key)
ANTHROPIC_API_KEY=""

# ===========================================
# DOCKER/COOLIFY
# ===========================================

# Password for PostgreSQL in docker-compose
DB_PASSWORD="your-secure-password"

# App URL (for production)
NEXT_PUBLIC_APP_URL="https://your-domain.com"
